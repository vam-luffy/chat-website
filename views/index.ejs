<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>All chats</title>
</head>
<body>
    <h3>All chats</h3>
    <form action="/chats/new" method="GET">
        <button>new chat</button>
       
    </form>
    <br>
    <%for(chat of chats){%>
        <div class="chat">
            <p>from: <i><%=chat.from%></i> </p>
            
            <div class="msg">
                <p>msg:<%=chat.msg%></p>
                <form action="/chats/<%=chat._id%>/edit"method="GET">
                    <button>edit</button>
                </form>

                <form action="/chats/<%=chat._id%>?_method=DELETE" method="POST">
                    <button>delete</button>
                </form>
                <form action="/chats/<%=chat._id%>" method="GET">
                    <button>show</button>
                </form>

            </div>
            <p>recievedBy: <i><%=chat.to%></i> </p>
            <p><%=chat.createdAt.toString().split(" ")[4]%></p>
            <p><%=chat.createdAt.toString().split(" ").slice(0,4).join(" ")%></p>
        </div>
        <br>
        <br>
   <% }%>
</body>
</html>