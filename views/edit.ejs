<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <h3>Edit Chat: <%= chat._id %></h3>
    <p>This chat was sent from <%= chat.from %> to: <%= chat.to %></p>

    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <textarea name="msg" rows="10" cols="50"><%= chat.msg %></textarea>
        <br>
        <button>Save Changes</button>
    </form>
    <br>
    <a href="/chats">Back to Chat List</a>
</body>
</html>
